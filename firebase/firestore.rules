rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isManager() { return signedIn() && resource.data.managerId == request.auth.uid; }
    function isMember() { return signedIn() && request.auth.uid in resource.data.memberIds; }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'language', 'updatedAt']);
      allow delete: if false;
    }
    match /kametis/{kametiId} {
      allow read: if isManager() || isMember();
      allow create: if signedIn() && request.resource.data.managerId == request.auth.uid
        && request.resource.data.status == 'processing'
        && request.resource.data.version == 1 && request.resource.data.schemaVersion == 1
        && request.resource.data.amount > 0 && request.resource.data.frequencyValue > 0
        && request.resource.data.memberCap >= 2 && request.resource.data.memberCap <= 100
        && request.resource.data.memberIds.size() == 0 && request.resource.data.memberOrder.size() == 0
        && request.time == request.resource.data.createdAt && request.time == request.resource.data.updatedAt;
      allow update: if isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'amount', 'frequencyValue', 'frequencyUnit', 'memberCap', 'memberIds', 'memberOrder', 'status', 'startedAt', 'firstTurnDate', 'updatedAt', 'version', 'schemaVersion'])
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.memberCap == resource.data.memberCap
        && request.resource.data.memberIds.size() <= request.resource.data.memberCap
        && request.resource.data.version == resource.data.version + 1
        && request.time == request.resource.data.updatedAt;
      allow update: if signedIn() && resource.data.status == 'processing'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= request.resource.data.memberCap
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.time == request.resource.data.updatedAt;
      allow delete: if false;
    }
    match /periods/{periodId} {
      allow read: if signedIn() && (get(/databases/$(database)/documents/kametis/$(resource.data.kametiId)).data.managerId == request.auth.uid || request.auth.uid in get(/databases/$(database)/documents/kametis/$(resource.data.kametiId)).data.memberIds);
      allow create: if signedIn() && get(/databases/$(database)/documents/kametis/$(request.resource.data.kametiId)).data.managerId == request.auth.uid
        && request.resource.data.periodIndex >= 0 && request.resource.data.turnHolderUid in get(/databases/$(database)/documents/kametis/$(request.resource.data.kametiId)).data.memberIds
        && request.resource.data.payments is map;
      allow update: if signedIn() && get(/databases/$(database)/documents/kametis/$(resource.data.kametiId)).data.managerId == request.auth.uid
        && request.resource.data.kametiId == resource.data.kametiId
        && request.resource.data.periodIndex == resource.data.periodIndex
        && request.resource.data.turnHolderUid == resource.data.turnHolderUid;
      allow delete: if false;
    }
  }
}
